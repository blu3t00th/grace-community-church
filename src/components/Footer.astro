---
import Container from './Container.astro';
import { primaryNav, siteConfig } from '../lib/site';
---

<footer class="site-footer mt-10 py-14">
  <Container>
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <section>
        <h2 class="text-2xl font-bold uppercase tracking-[0.06em]">{siteConfig.name}</h2>
        <p class="footer-muted mt-3">Welcoming people to know Jesus, find community, and live on mission in Stockholm.</p>
      </section>

      <section>
        <h2 class="text-xl font-bold uppercase tracking-[0.06em]">Service</h2>
        <p class="footer-muted mt-3">{siteConfig.serviceTime}</p>
        <p class="footer-muted">{siteConfig.address}</p>
      </section>

      <section>
        <h2 class="text-xl font-bold uppercase tracking-[0.06em]">Contact</h2>
        <ul class="footer-muted mt-3 space-y-2">
          <li>
            <a href={`mailto:${siteConfig.email}`} class="no-underline">{siteConfig.email}</a>
          </li>
          <li>
            <a href={`tel:${siteConfig.phone.replace(/\s+/g, '')}`} class="no-underline">{siteConfig.phone}</a>
          </li>
        </ul>
      </section>

      <section>
        <h2 class="text-xl font-bold uppercase tracking-[0.06em]">Explore</h2>
        <ul class="footer-muted mt-3 grid grid-cols-2 gap-2 text-sm sm:grid-cols-1">
          {primaryNav.map((item) => (
            <li>
              <a class="no-underline" href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <div class="footer-divider footer-muted mt-10 border-t pt-5 text-sm">
      <p>&copy; {new Date().getFullYear()} {siteConfig.name}. All rights reserved.</p>
    </div>
  </Container>
</footer>
