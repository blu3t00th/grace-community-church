---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  target?: '_blank' | '_self' | '_parent' | '_top';
  rel?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className = '',
  target,
  rel
} = Astro.props;

const variantClasses = {
  primary:
    'border border-transparent bg-sand-900 text-white hover:-translate-y-0.5 hover:bg-black hover:shadow-[0_10px_22px_rgba(16,15,13,0.25)]',
  secondary:
    'border border-transparent bg-pine-600 text-white hover:-translate-y-0.5 hover:bg-pine-700 hover:shadow-[0_10px_24px_rgba(59,95,205,0.28)]',
  ghost:
    'border border-sand-300 bg-white/90 text-sand-900 hover:-translate-y-0.5 hover:border-sand-400 hover:bg-sand-100/70'
}[variant];

const sizeClasses = {
  sm: 'px-4 py-2 text-[0.78rem]',
  md: 'px-5 py-3 text-[0.9rem]',
  lg: 'px-6 py-3.5 text-[0.9rem]'
}[size];

const baseClasses = `inline-flex items-center justify-center rounded-full font-bold uppercase tracking-[0.08em] transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pine-500 focus-visible:ring-offset-2 focus-visible:ring-offset-sand-50 ${variantClasses} ${sizeClasses} ${className}`;
---

{href ? (
  <a href={href} class={baseClasses} target={target} rel={rel}>
    <slot />
  </a>
) : (
  <button type={type} class={baseClasses}>
    <slot />
  </button>
)}
