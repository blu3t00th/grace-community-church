---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/Container.astro';
import PageHero from '../components/PageHero.astro';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
}

const { title, description, eyebrow, image, canonical, type = 'article' } = Astro.props;
const hasMeta = Astro.slots.has('meta');
---

<BaseLayout title={title} description={description} image={image} canonical={canonical} type={type}>
  <PageHero title={title} description={description} eyebrow={eyebrow} />
  <Container class="section-padding">
    <article class="card">
      {hasMeta && (
        <div class="mb-8 border-b border-sand-200 pb-6">
          <slot name="meta" />
        </div>
      )}
      <div class="prose-content">
        <slot />
      </div>
    </article>
    <slot name="after" />
  </Container>
</BaseLayout>
