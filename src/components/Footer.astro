---
import Container from './Container.astro';
import { primaryNav, siteConfig } from '../lib/site';
---

<footer class="mt-10 border-t border-sand-200 bg-sand-900 py-14 text-sand-100">
  <Container>
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <section>
        <h2 class="text-2xl font-bold uppercase tracking-[0.06em] text-white">{siteConfig.name}</h2>
        <p class="mt-3 text-sand-300">Welcoming people to know Jesus, find community, and live on mission in Stockholm.</p>
      </section>

      <section>
        <h2 class="text-xl font-bold uppercase tracking-[0.06em] text-white">Service</h2>
        <p class="mt-3 text-sand-300">{siteConfig.serviceTime}</p>
        <p class="text-sand-300">{siteConfig.address}</p>
      </section>

      <section>
        <h2 class="text-xl font-bold uppercase tracking-[0.06em] text-white">Contact</h2>
        <ul class="mt-3 space-y-2 text-sand-300">
          <li>
            <a href={`mailto:${siteConfig.email}`} class="no-underline hover:text-white">{siteConfig.email}</a>
          </li>
          <li>
            <a href={`tel:${siteConfig.phone.replace(/\s+/g, '')}`} class="no-underline hover:text-white">{siteConfig.phone}</a>
          </li>
        </ul>
      </section>

      <section>
        <h2 class="text-xl font-bold uppercase tracking-[0.06em] text-white">Explore</h2>
        <ul class="mt-3 grid grid-cols-2 gap-2 text-sm text-sand-300 sm:grid-cols-1">
          {primaryNav.map((item) => (
            <li>
              <a class="no-underline hover:text-white" href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <div class="mt-10 border-t border-sand-700 pt-5 text-sm text-sand-400">
      <p>&copy; {new Date().getFullYear()} {siteConfig.name}. All rights reserved.</p>
    </div>
  </Container>
</footer>
