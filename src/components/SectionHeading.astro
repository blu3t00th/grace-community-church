---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  centered?: boolean;
}

const { title, description, eyebrow, centered = false } = Astro.props;
---

<div class:list={[centered ? 'text-center' : '', 'space-y-3']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="text-4xl font-bold uppercase leading-[0.95] sm:text-5xl">{title}</h2>
  {description && (
    <p class="max-w-3xl text-lg text-sand-700 sm:text-xl" class:list={[centered ? 'mx-auto' : '']}>
      {description}
    </p>
  )}
</div>
