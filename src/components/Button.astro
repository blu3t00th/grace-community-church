---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  target?: '_blank' | '_self' | '_parent' | '_top';
  rel?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className = '',
  target,
  rel
} = Astro.props;

const variantClasses = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  ghost: 'btn-ghost'
}[variant];

const sizeClasses = {
  sm: 'btn-sm',
  md: 'btn-md',
  lg: 'btn-lg'
}[size];

const baseClasses = `btn ${variantClasses} ${sizeClasses} ${className}`;
---

{href ? (
  <a href={href} class={baseClasses} target={target} rel={rel}>
    <slot />
  </a>
) : (
  <button type={type} class={baseClasses}>
    <slot />
  </button>
)}
